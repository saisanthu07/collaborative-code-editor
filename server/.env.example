NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://localhost:27017/collab-editor

# Must be at least 32 characters and not the example placeholder
JWT_SECRET=replace-with-a-random-32-char-or-longer-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
GUEST_TOKEN_TTL_HOURS=24
MAX_GUESTS_PER_ROOM=50

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Code Execution Engine (Judge0 + Piston fallback)
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=ce.judge0.com
PISTON_API_URL=https://emkc.org/api/v2/piston

# Only set true for offline local dev JS execution in a worker thread (never in production)
ALLOW_UNSAFE_LOCAL_EXEC=false

# Redis (enables multi-instance Socket.IO, Yjs sync, presence & distributed rate limiting)
REDIS_URL=

# Optional WebRTC TURN server for voice calls behind strict NATs
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Optional bearer token for /api/metrics scraping
METRICS_TOKEN=
